GEMCP_ENV=production
GEMCP_ADDRESS=:8080
GEMCP_PORT=8080
GEMCP_LOG_LEVEL=info
GEMCP_DATABASE_CONNECT_TIMEOUT=10s
GEMCP_SHUTDOWN_TIMEOUT=15s

POSTGRES_USER=gemcp
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=gemcp
GEMCP_DATABASE_URL=postgres://gemcp:replace-with-a-long-random-password@postgres:5432/gemcp?sslmode=disable

# Phase-zero only. Set interactively; never persist a real value here.
# GEMCP_PHASE0_AUTODL_TOKEN=
# GEMCP_PHASE0_AUTODL_BASE_URL=https://api.autodl.com
