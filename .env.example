GEMCP_VERSION=0.6.3
GEMCP_COMMIT=set-to-the-full-release-commit-sha
GEMCP_BUILT_AT=set-to-an-rfc3339-build-time
GEMCP_ENV=production
GEMCP_ADDRESS=:8080
GEMCP_PORT=8080
GEMCP_LOG_LEVEL=info
GEMCP_AUTO_MIGRATE=true
GEMCP_SECURE_COOKIES=true
GEMCP_MASTER_KEY=generate-with-gemcp-keygen
GEMCP_BOOTSTRAP_TOKEN=generate-with-gemcp-bootstrap-token
GEMCP_DATABASE_CONNECT_TIMEOUT=10s
GEMCP_SHUTDOWN_TIMEOUT=15s

# Keep new dispatch disabled until GEMCP_PUBLIC_URL is reachable over HTTPS and the watchdog is running.
GEMCP_SCHEDULER_ENABLED=false
GEMCP_PUBLIC_URL=https://gemcp.example.com
GEMCP_GLOBAL_CONCURRENCY=1
GEMCP_SCHEDULER_POLL_INTERVAL=5s
GEMCP_EXECUTION_LEASE_DURATION=2m
GEMCP_PROVISION_TIMEOUT=10m
GEMCP_RECONCILE_DELAY=2m
GEMCP_CALLBACK_GRACE=45s
GEMCP_MAX_ATTEMPTS=3
GEMCP_RUNNER_SOURCE_MAX_BYTES=268435456
GEMCP_WATCHDOG_POLL_INTERVAL=10s
GEMCP_WATCHDOG_LEASE_DURATION=2m
GEMCP_WATCHDOG_BATCH_SIZE=100
GEMCP_NOTIFICATION_POLL_INTERVAL=10s

POSTGRES_USER=gemcp
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=gemcp
GEMCP_POSTGRES_DATA_DIR=./postgres_data
GEMCP_DATABASE_URL=postgres://gemcp:replace-with-a-long-random-password@postgres:5432/gemcp?sslmode=disable

# Phase-zero only. Set interactively; never persist a real value here.
# GEMCP_PHASE0_AUTODL_TOKEN=
# Optional override. Backend defaults: public=https://api.autodl.com, private=https://private.autodl.com
# GEMCP_PHASE0_AUTODL_BASE_URL=https://api.autodl.com
