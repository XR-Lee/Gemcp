# Local HTTP control plane. Copy to the repo-root `.env` (or run
# ./scripts/bootstrap-local.sh). This is not the production Compose file.
#
# The binary reads repo-root `.env` on `serve` / `watchdog`. Process
# environment still wins. Do not commit the generated `.env`.

GEMCP_ENV=development
GEMCP_ADDRESS=:8080
GEMCP_PORT=8080
GEMCP_LOG_LEVEL=info
GEMCP_AUTO_MIGRATE=true
GEMCP_SECURE_COOKIES=false
GEMCP_PUBLIC_URL=http://127.0.0.1:8080
# Local HTTP only. Set false to require the Owner password again.
GEMCP_DEV_SKIP_PASSWORD=true

# Replaced by ./scripts/bootstrap-local.sh or `./bin/gemcp keygen` /
# `./bin/gemcp bootstrap-token`. The placeholder strings will not start serve.
GEMCP_MASTER_KEY=generate-with-gemcp-keygen
GEMCP_BOOTSTRAP_TOKEN=generate-with-gemcp-bootstrap-token

GEMCP_DATABASE_CONNECT_TIMEOUT=10s
GEMCP_SHUTDOWN_TIMEOUT=15s

# Local CPU loop (no NVIDIA). Scheduler + Cloud SSH + loopback process
# overlay. Production Compose should leave these false unless you intend
# outbound SSH. Restart serve after changing them.
GEMCP_SELF_HOSTED_ENABLED=false
GEMCP_SSH_CLOUD_ENABLED=true
GEMCP_LOCAL_PROCESS_ENABLED=true
GEMCP_SCHEDULER_ENABLED=true

# Distro PostgreSQL 16+ is enough for local HTTP. Production Compose still
# uses postgres:18-alpine. No GPU is required.
POSTGRES_USER=gemcp
POSTGRES_PASSWORD=gemcp
POSTGRES_DB=gemcp
GEMCP_DATABASE_URL=postgres://gemcp:gemcp@127.0.0.1:5432/gemcp?sslmode=disable

# Used only by ./scripts/local-http-smoke.sh (skip_provider + login). The
# control plane ignores these names.
GEMCP_DEV_OWNER_EMAIL=owner@localhost
GEMCP_DEV_OWNER_PASSWORD=local-dev-owner-password
GEMCP_DEV_ORGANIZATION="Local Lab"
GEMCP_DEV_PROJECT_NAME="Local Project"
GEMCP_DEV_PROJECT_SLUG=local-project
