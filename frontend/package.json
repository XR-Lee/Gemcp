{
  "name": "gemcp-frontend",
  "private": true,
  "version": "0.15.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:validation": "npm run build && playwright test --config=playwright.validation.config.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "1.24.0",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
