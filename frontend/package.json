{
  "name": "gemcp-frontend",
  "private": true,
  "version": "0.16.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
